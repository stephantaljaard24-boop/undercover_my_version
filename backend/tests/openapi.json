          },
          "finished": {
            "title": "Finished",
            "type": "boolean"
          },
          "run_id": {
            "title": "Run Id",
            "type": "integer"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "todos": {
            "items": {
              "$ref": "#/components/schemas/Todo"
            },
            "title": "Todos",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "claim_limit",
          "todos",
          "summary",
          "finished"
        ],
        "title": "Run",
        "type": "object"
      },
      "SectionRead": {
        "properties": {
          "document": {
