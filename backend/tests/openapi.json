{
  "components": {
    "schemas": {
      "ClaimDetail": {
        "properties": {
          "amount_claimed": {
            "title": "Amount Claimed",
            "type": "string"
          },
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "claim_type": {
            "title": "Claim Type",
            "type": "string"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Decision-Output"
              },
              {
                "type": "null"
              }
            ]
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/Document"
            },
            "title": "Documents",
            "type": "array"
          },
          "incident_date": {
            "format": "date",
            "title": "Incident Date",
            "type": "string"
          },
          "incident_location": {
            "title": "Incident Location",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "title": "Items",
            "type": "array"
          },
          "payment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Payment-Output"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy_id": {
            "title": "Policy Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "waiting",
              "in_progress",
              "awaiting_sign_off",
              "decided",
              "needs_handler"
            ],
            "title": "Status",
            "type": "string"
          },
          "story": {
            "title": "Story",
            "type": "string"
          },
          "submitted_on": {
            "format": "date",
            "title": "Submitted On",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "policy_id",
          "customer_id",
          "claim_type",
          "submitted_on",
          "incident_date",
          "incident_location",
          "summary",
          "story",
          "items",
          "amount_claimed",
          "documents",
          "status",
          "decision",
          "payment"
        ],
        "title": "ClaimDetail",
        "type": "object"
      },
      "ClaimLimit": {
        "properties": {
          "claim_limit": {
            "minimum": 1.0,
            "title": "Claim Limit",
            "type": "integer"
          }
        },
        "required": [
          "claim_limit"
        ],
        "title": "ClaimLimit",
        "type": "object"
      },
      "ClaimSummary": {
        "properties": {
          "amount_claimed": {
            "title": "Amount Claimed",
            "type": "string"
          },
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "claim_type": {
            "title": "Claim Type",
            "type": "string"
          },
          "customer_name": {
            "title": "Customer Name",
            "type": "string"
          },
          "decision": {
            "anyOf": [
              {
                "enum": [
                  "approve",
                  "decline",
                  "refer"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision"
          },
          "payout": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payout"
          },
          "status": {
            "enum": [
              "waiting",
              "in_progress",
              "awaiting_sign_off",
              "decided",
              "needs_handler"
            ],
            "title": "Status",
            "type": "string"
          },
          "submitted_on": {
            "format": "date",
            "title": "Submitted On",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "customer_name",
          "claim_type",
          "summary",
          "submitted_on",
          "amount_claimed",
          "status",
          "decision",
          "payout"
        ],
        "title": "ClaimSummary",
        "type": "object"
      },
      "Customer": {
        "properties": {
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "customer_since": {
            "format": "date",
            "title": "Customer Since",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "previous_claims": {
            "items": {
              "$ref": "#/components/schemas/PreviousClaim"
            },
            "title": "Previous Claims",
            "type": "array"
          }
        },
        "required": [
          "customer_id",
          "name",
          "customer_since",
          "previous_claims"
        ],
        "title": "Customer",
        "type": "object"
      },
      "Decision-Input": {
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "decline",
              "refer"
            ],
            "title": "Decision",
            "type": "string"
          },
          "explanation": {
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          },
          "payout": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Payout"
          },
          "policy_section": {
            "minLength": 1,
            "title": "Policy Section",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "payout",
          "explanation",
          "policy_section"
        ],
        "title": "Decision",
        "type": "object"
      },
      "Decision-Output": {
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "decline",
              "refer"
            ],
            "title": "Decision",
            "type": "string"
          },
          "explanation": {
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          },
          "payout": {
            "title": "Payout",
            "type": "string"
          },
          "policy_section": {
            "minLength": 1,
            "title": "Policy Section",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "payout",
          "explanation",
          "policy_section"
        ],
        "title": "Decision",
        "type": "object"
      },
      "Document": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "content"
        ],
        "title": "Document",
        "type": "object"
      },
      "Failure": {
        "properties": {
          "reason": {
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "Failure",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Item": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "description",
          "category",
          "amount"
        ],
        "title": "Item",
        "type": "object"
      },
      "Payment-Input": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Amount"
          }
        },
        "required": [
          "amount"
        ],
        "title": "Payment",
        "type": "object"
      },
      "Payment-Output": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          }
        },
        "required": [
          "amount"
        ],
        "title": "Payment",
        "type": "object"
      },
      "Policy": {
        "properties": {
          "add_ons": {
            "items": {
              "type": "string"
            },
            "title": "Add Ons",
            "type": "array"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "plan": {
            "title": "Plan",
            "type": "string"
          },
          "policy_id": {
            "title": "Policy Id",
            "type": "string"
          },
          "purchased_on": {
            "format": "date",
            "title": "Purchased On",
            "type": "string"
          },
          "sold_through": {
            "title": "Sold Through",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "travelers": {
            "items": {
              "type": "string"
            },
            "title": "Travelers",
            "type": "array"
          },
          "trip": {
            "$ref": "#/components/schemas/Trip"
          }
        },
        "required": [
          "policy_id",
          "customer_id",
          "plan",
          "add_ons",
          "purchased_on",
          "sold_through",
          "trip",
          "travelers",
          "status"
        ],
        "title": "Policy",
        "type": "object"
      },
      "PreviousClaim": {
        "properties": {
          "amount_paid": {
            "title": "Amount Paid",
            "type": "string"
          },
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "claim_type": {
            "title": "Claim Type",
            "type": "string"
          },
          "filed_on": {
            "format": "date",
            "title": "Filed On",
            "type": "string"
          },
          "incident_date": {
            "format": "date",
            "title": "Incident Date",
            "type": "string"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
