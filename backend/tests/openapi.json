          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document",
          "section",
          "title"
        ],
        "title": "SectionRead",
        "type": "object"
      },
      "SectionRef": {
        "properties": {
          "document": {
            "title": "Document",
            "type": "string"
          },
          "section": {
