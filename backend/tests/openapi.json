          }
        },
        "required": [
          "kind",
          "text"
        ],
        "title": "Step",
        "type": "object"
      },
      "Summary": {
        "properties": {
          "summary": {
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "summary"
        ],
        "title": "Summary",
        "type": "object"
      },
      "Todo": {
        "properties": {
          "status": {
            "enum": [
              "todo",
              "in_progress",
              "done",
              "left_for_handler"
            ],
            "title": "Status",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "status"
        ],
        "title": "Todo",
        "type": "object"
      },
      "TodoList": {
        "properties": {
          "todos": {
            "items": {
              "$ref": "#/components/schemas/Todo"
            },
